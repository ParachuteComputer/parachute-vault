{
  "name": "@openparachute/vault",
  "version": "0.7.2-rc.3",
  "description": "Agent-native knowledge graph. Notes, tags, links over MCP.",
  "module": "src/cli.ts",
  "type": "module",
  "bin": {
    "parachute-vault": "src/cli.ts"
  },
  "files": [
    "src",
    "core/src",
    "core/package.json",
    ".parachute",
    "tsconfig.json",
    "web/ui/dist"
  ],
  "scripts": {
    "start": "bun src/server.ts",
    "cli": "bun src/cli.ts",
    "test": "bun test ./src/",
    "test:core": "cd core && node --experimental-vm-modules node_modules/vitest/dist/cli.js run",
    "typecheck": "tsc --noEmit",
    "build:spa": "cd web/ui && bun install --frozen-lockfile && bun run build",
    "prepack": "bun run build:spa"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@openparachute/scope-guard": "^0.5.0",
    "jose": "^6.2.2",
    "otpauth": "^9.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ParachuteComputer/parachute-vault.git"
  },
  "license": "AGPL-3.0"
}
